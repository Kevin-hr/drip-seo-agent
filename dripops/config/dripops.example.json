{
  "storeOrigin": "https://www.dripsneakers.org",
  "adminOrigin": "https://www.mrshopplus.com",
  "chromeProfileDirectory": "data/chrome-profile",
  "chromeExecutablePath": null,
  "chromeDebugPort": 9333,
  "stateDirectory": "data/runs",
  "exchangeDirectory": "data/ai-exchange",
  "standardPath": "standards/SEO-PDP-3.2.json",
  "standardV44Path": "standards/SEO-PDP-V4.4.json",
  "standardV44DocumentPath": "standards/Drip_Sneakers_SEO-PDP_V4.4_STANDARD_FINAL.md",
  "bridgeDirectory": "data/bridge",
  "bridgeHost": "127.0.0.1",
  "bridgePort": 8787,
  "executionMode": "live",
  "snapshotMaxAgeHours": 24,
  "requireCompleteSnapshot": true,
  "headless": false,
  "autoPublishPassOnly": true,
  "trustClaims": {
    "qcPhotosVerified": false,
    "thirtyDayReturnsVerified": false,
    "deliveryWindowVerified": false,
    "deliveryWindow": "7-20 day delivery",
    "verifiedAt": null
  },
  "aiProviders": [
    {
      "name": "manual-file",
      "kind": "file",
      "enabled": true
    },
    {
      "name": "local-ollama",
      "kind": "openai-compatible",
      "enabled": false,
      "endpoint": "http://127.0.0.1:11434/v1/chat/completions",
      "model": "your-local-model",
      "apiKeyEnvironmentVariable": null
    }
  ],
  "typeSafe": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-latest",
    "apiKeyEnvironmentVariable": "TYPESAFE_API_KEY",
    "enabled": false,
    "noulSupportThreshold": 0.85,
    "scoreHighThreshold": 0.7
  }
}
