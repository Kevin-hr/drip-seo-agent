      "why": "A batch suffix looks like a model discriminator but carries no identity. Supplier noise must never reach the generator.",
      "sku_policy": "v44_standard",
      "input": {
        "supplier": { "title": "Prada Logo T-Shirt-DC2", "sku": "DC2", "images": 6 },
        "identity": {
          "brand": "Prada",
          "model": "",
          "product_type": "T-Shirt",
          "colorway": "",
          "collection": null,
          "official_name_matched": false,
          "colorway_has_tier14": false,
          "collection_unverifiable": false,
          "multiple_candidates": true,
          "field_missing": true
        },
        "sku_candidates": [
          { "value": "DC2", "sku_type": "supplier_batch_suffix", "entity_ref": "prada-logo-tee", "evidence": [] }
        ],
        "evidence": { "official_source": "", "confidence": "low", "gaps": ["no official name", "no official colorway"] },
        "reconciliation": { "duplicate_same_slug": false },
        "verification": { "save_readback": "NOT_RUN", "publish_readback": "NOT_RUN", "storefront": "NOT_RUN" }
      },
      "expect": {
        "final_status": "HOLD",
        "sku_verdict": "SKU_OMIT",
        "sku_rejections": [{ "value": "DC2", "reason": "SKU-TYPE-REJECTED" }],
        "hold_codes": ["ID-FIELD-MISSING", "ID-NAME-UNMATCHED", "ID-COLORWAY-UNVERIFIED", "ID-MULTI-CANDIDATE", "EVD-EMPTY", "EVD-LOW-CONFIDENCE", "EVD-GAPS-PRESENT"],
        "action_permission": "FORBID_UPDATE"
      }
    },
