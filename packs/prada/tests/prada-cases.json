      "source": "Pack verified_success: ProductID 536027476120336; official code list from the Prada 78 manifest",
      "why": "Kills two birds: the pack template must reproduce the real on-site name, and a genuine brand code must reach VERIFIED_SKU.",
      "expect_product_name": "Prada America's Cup Patent Leather Sneakers Grey White",
      "sku_policy": "v44_standard",
      "input": {
        "supplier": { "title": "Prada Americas Cup Patent Grey White", "sku": "DC2", "images": 12 },
        "identity": {
          "brand": "Prada",
          "model": "America's Cup",
          "product_type": "Sneakers",
          "colorway": "Grey White",
          "collection": "America's Cup",
          "descriptor": "Patent Leather Sneakers",
          "official_name_matched": true,
          "colorway_has_tier14": true,
          "collection_unverifiable": false,
          "multiple_candidates": false,
          "field_missing": false,
          "decision_sentence": "The Prada America's Cup Patent Leather Sneakers in Grey White pair a patent leather upper with a rubber cup sole.",
          "brand_internal_url": "https://www.dripsneakers.org/Prada-Sneakers/"
        },
        "sku_candidates": [
          {
            "value": "2EG479 D7C F0008 F G001",
            "sku_type": "official_brand_code",
            "entity_ref": "prada-americas-cup-patent-grey-white",
            "evidence": [
              { "tier": 1, "source_name": "Prada official", "url": "https://www.prada.com/example-americas-cup", "exact_entity_match": true, "sku": "2EG479 D7C F0008 F G001" }
            ]
          },
          { "value": "DC2", "sku_type": "supplier_batch_suffix", "entity_ref": "prada-americas-cup-patent-grey-white", "evidence": [] }
        ],
        "evidence": { "official_source": "https://www.prada.com/example-americas-cup", "confidence": "high", "gaps": [] },
        "reconciliation": { "duplicate_same_slug": false },
        "verification": { "save_readback": "PASS", "publish_readback": "PASS", "storefront": "PASS" }
      },
      "expect": {
        "final_status": "PASS",
        "sku_verdict": "VERIFIED_SKU",
        "sku_rejections": [{ "value": "DC2", "reason": "SKU-TYPE-REJECTED" }],
        "hold_codes": [],
        "action_permission": "ALLOW_SEO_UPDATE"
      }
    },
    {
      "id": "PC-002",
      "title": "Internal catalogue code is rejected and the product still publishes with SKU omitted",
      "source": "Prada 78 identity-audit: 66 of 78 SKU values were sku_type=internal_catalog (DS-PRA-001..078)",
      "why": "The headline Prada lesson. A rejected code must not block an otherwise verifiable product, and must not be recorded as absence.",
      "sku_policy": "v44_standard",
      "input": {
        "supplier": { "title": "Prada Pocket T-Shirt-DC2", "sku": "DS-PRA-010", "images": 7 },
