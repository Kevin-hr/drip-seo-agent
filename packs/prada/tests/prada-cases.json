  "core_required": "feature/seo-pdp-intelligence-core-v1 (>= ce99c80a)",
  "purpose": "Prove the Prada pack plugs into the Core: it narrows permissions, it rejects its own known-bad codes, and it cannot widen the Core.",
  "pipeline_cases": [
