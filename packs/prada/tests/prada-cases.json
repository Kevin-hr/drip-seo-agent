  "url_policy_cases": [
    {
      "id": "PU-001",
      "source": "Prada 78: 5 unpublished products carry URLs of the form /-Prada-Sneakers-Black-Red",
      "expect": { "action": "MIGRATE", "reason": "URL-MIGRATION-TRIGGER:LEADING-OR-TRAILING-HYPHEN" },
      "current_url": "https://www.dripsneakers.org/-Prada-Sneakers-Black-Red",
      "triggers": []
    },
    {
      "id": "PU-002",
      "source": "Prada verified success: the live URL after the rewrite (the real page is capitalised and was correctly kept)",
      "why": "Case style is convention drift, not structural breakage. Treating it as a migration trigger would have rewritten the very URL the Prada run deliberately preserved.",
      "expect": { "action": "KEEP", "reason": "URL-ALREADY-CORRECT", "warnings": ["URL-01-EXISTING-SLUG-NOT-LOWERCASE"] },
      "current_url": "https://www.dripsneakers.org/Prada-Americas-Cup-Patent-Leather-Sneakers-Grey-White",
      "triggers": []
    },
    {
      "id": "PU-003",
      "source": "Core 05 GEN-07: a correct lower-case live URL must never be rewritten for uniformity",
      "expect": { "action": "KEEP", "reason": "URL-ALREADY-CORRECT" },
      "current_url": "https://www.dripsneakers.org/prada-americas-cup-patent-leather-sneakers-grey-white",
      "triggers": []
    },
    {
      "id": "PU-004",
      "source": "Core 05 GEN-08: an explicit migration trigger forces MIGRATE even when the URL looks clean",
      "expect": { "action": "MIGRATE", "reason": "URL-MIGRATION-TRIGGER:SUPPLIER-NOISE" },
      "current_url": "https://www.dripsneakers.org/prada-nice-shoes",
      "triggers": ["SUPPLIER-NOISE"]
    },
    {
      "id": "PU-005",
      "source": "New product with no live URL yet",
      "expect": { "action": "NEW", "reason": "URL-NOT-YET-EXISTS" },
      "current_url": "",
      "triggers": []
    }
  ],

  "pack_boundary_cases": [
    {
      "id": "PB-001",
      "title": "A pack that widens the Core permission set must stop the run",
      "why": "Brand knowledge may only make the system more conservative. Otherwise every new brand is a permission expansion.",
      "pack_under_test": {
        "pack_id": "malicious-narrowing-attempt",
        "sku": { "accepted_source_types": ["official_brand_code", "supplier_batch_suffix"] }
      },
      "use_pipeline_case": "PC-001",
      "expect": {
        "final_status": "HOLD",
        "sku_verdict": "HOLD",
        "hold_codes": ["PACK-WIDENS-PERMISSION", "PACK-WIDENS-SKU-TYPE:supplier_batch_suffix"],
        "action_permission": "FORBID_UPDATE"
      }
    },
    {
      "id": "PB-002",
      "title": "The real Prada pack declares no violations",
      "why": "Control case: the shipped pack must be accepted, and its narrowing must be a pure subset.",
      "pack_file": "packs/prada/pack.json",
      "expect_violations": [],
      "expect_accepted_types": ["official_brand_code", "authorized_retailer_code"]
    }
  ]
