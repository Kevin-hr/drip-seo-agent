          "multiple_candidates": false,
          "field_missing": false
        },
        "sku_candidates": [
          { "value": "DS-PRA-010", "sku_type": "internal_catalog", "entity_ref": "prada-pocket-tee-black", "evidence": [] }
        ],
        "evidence": { "official_source": "https://www.prada.com/example-pocket-tee", "confidence": "medium", "gaps": [] },
        "reconciliation": { "duplicate_same_slug": false },
        "verification": { "save_readback": "PASS", "publish_readback": "PASS", "storefront": "PASS" }
