HOST=127.0.0.1
# MCP server
PORT=8000

# Existing local Agent bridge. Keep this private/local when using Secure MCP Tunnel.
LOCAL_AGENT_BASE_URL=http://127.0.0.1:8787
LOCAL_AGENT_TOKEN=change-me
LOCAL_AGENT_TIMEOUT_MS=120000

# Narrow bridge paths. Map these to your already-running workflow if your route names differ.
AGENT_PRODUCT_SEARCH_PATH=/api/chatgpt-mcp/products/search
AGENT_PRODUCT_READ_PATH=/api/chatgpt-mcp/products/read
AGENT_PRODUCT_PREPARE_PATH=/api/chatgpt-mcp/products/prepare-v44
AGENT_PRODUCT_EXECUTE_PATH=/api/chatgpt-mcp/products/execute-v44
AGENT_PRODUCT_VERIFY_PATH=/api/chatgpt-mcp/products/verify-v44
AGENT_CATEGORY_SEARCH_PATH=/api/chatgpt-mcp/categories/search
AGENT_CATEGORY_READ_PATH=/api/chatgpt-mcp/categories/read
AGENT_CATEGORY_PREPARE_PATH=/api/chatgpt-mcp/categories/prepare-seo
AGENT_CATEGORY_EXECUTE_PATH=/api/chatgpt-mcp/categories/execute-seo
AGENT_CATEGORY_VERIFY_PATH=/api/chatgpt-mcp/categories/verify-seo
AGENT_RUN_STATUS_PATH=/api/chatgpt-mcp/runs/status

# Canonical SEO-PDP standard. Leave empty to use the bundled
# rules/Drip_Sneakers_SEO-PDP_V4.4_STANDARD_FINAL.md
# SEO/PDP 3.2 and the superseded V4.4 CLEAN_CONSOLIDATED revision are rejected outright.
#STANDARD_PATH=
# Optional fail-closed pin. When set, the server refuses to start if the loaded
# document does not hash to this value (SHA-256, lower-case hex).
STANDARD_EXPECTED_SHA256=965314cdb899bfddaafd25d6e083bff6861663c38a7860f553be7e4b34d3e5b7
